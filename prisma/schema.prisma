generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Membership {
  FREE
  PREMIUM
}

enum Visibility {
  FREE
  PREMIUM
}

enum PromptDomain {
  ia
  entrepreneuriat
  productivite
  communication
}

enum Level {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum Format {
  PRESENTIEL
  EN_LIGNE
  HYBRIDE
}

enum FormationKind {
  PERMANENTE
  EVENEMENTIELLE
}

enum OpportuniteType {
  STAGE
  EMPLOI
  APPEL_OFFRE
  FINANCEMENT
  COLLABORATION
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String
  membership            Membership             @default(FREE)
  accounts              Account[]
  sessions              Session[]
  inscriptions          Inscription[]
  formationInscriptions FormationInscription[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Prompt {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  summary     String
  excerpt     String?
  body        String       @default("")
  domain      PromptDomain @default(ia)
  tags        String[]     @default([])
  coverImage  String?
  visibility  Visibility   @default(FREE)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([publishedAt, domain])
}

model Formation {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  title        String
  summary      String
  excerpt      String?
  body         String
  visibility   Visibility             @default(FREE)
  publishedAt  DateTime?
  level        Level
  format       Format
  durationH    Int?
  kind         FormationKind
  startsAt     DateTime?
  coverImage   String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inscriptions FormationInscription[]

  @@index([publishedAt, startsAt])
  @@index([kind])
  @@index([level])
}

model Jeu {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String
  excerpt      String?
  body         String
  visibility   Visibility    @default(FREE)
  startsAt     DateTime?
  closesAt     DateTime?
  capacity     Int?
  location     String?
  coverImage   String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  inscriptions Inscription[]

  @@index([publishedAt])
}

model Inscription {
  id        String   @id @default(cuid())
  userId    String
  jeuId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jeu       Jeu      @relation(fields: [jeuId], references: [id], onDelete: Cascade)

  @@unique([userId, jeuId])
  @@index([jeuId])
}

model FormationInscription {
  id          String    @id @default(cuid())
  userId      String
  formationId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([userId, formationId])
  @@index([formationId])
}

model Opportunite {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  summary     String
  excerpt     String?
  body        String
  visibility  Visibility      @default(FREE)
  publishedAt DateTime?
  type        OpportuniteType
  organisme   String
  deadline    DateTime?
  externalUrl String?
  coverImage  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([publishedAt, deadline])
  @@index([type])
}

model RateLimit {
  identifier  String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

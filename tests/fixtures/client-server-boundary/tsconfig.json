{
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "strict": true,
    "target": "ES2017"
  },
  "include": [".next/types/**/*.ts", "**/*.ts", "**/*.tsx"]
}
